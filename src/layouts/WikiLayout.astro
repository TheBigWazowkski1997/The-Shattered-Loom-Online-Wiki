---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  headings?: any[];
  frontmatter?: any;
}

const { title, description, currentSlug = '', headings = [], frontmatter = {} } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${title} | The Shattered Loom Wiki`} description={description}>
  <!-- Top Reading Progress Indicator -->
  <div id="reading-progress" class="reading-progress-bar"></div>

  <Header />

  <div class="wiki-main-container">
    <Sidebar currentSlug={currentSlug} />

    <main class="wiki-content-area">
      <div class="article-wrapper">
        <Breadcrumbs currentSlug={currentSlug} title={title} />

        <article class="wiki-article glass-panel">
          <header class="article-header">
            <h1 class="article-title">{title}</h1>
            <div class="article-meta">
              <span class="badge">D&D 5E Setting</span>
              {frontmatter.aliases && (
                <span class="aliases-text">Known as: {Array.isArray(frontmatter.aliases) ? frontmatter.aliases.join(', ') : frontmatter.aliases}</span>
              )}
            </div>
          </header>

          <div class="article-body">
            <slot />
          </div>

          <footer class="article-footer">
            <div class="footer-quote">
              <em>"Every door is a gateway, every stranger is a survivor, and every step is a choice between restoration... or unraveling."</em>
            </div>
            <div class="footer-links">
              <a href="https://github.com/TheBigWazowkski1997/The-Shattered-Loom-Online-Wiki" target="_blank" rel="noopener">
                ✦ View Source Repository
              </a>
              <a href={`${baseUrl}/`} class="back-to-portal">
                Return to Multiverse Portal ↑
              </a>
            </div>
          </footer>
        </article>
      </div>
    </main>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold-secondary), var(--gold-primary), var(--crimson-primary));
    width: 0%;
    z-index: 200;
    transition: width 0.1s ease;
    box-shadow: 0 0 10px rgba(229, 184, 90, 0.7);
  }

  .wiki-main-container {
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    position: relative;
    z-index: 10;
  }

  .wiki-content-area {
    flex: 1;
    min-width: 0;
    padding: 2rem 2.5rem 4rem 2.5rem;
  }

  .article-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .wiki-article {
    padding: 2.5rem 3rem;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    background: var(--bg-surface);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--shadow-elevation);
  }

  .article-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
  }

  .article-title {
    font-size: 2.4rem;
    margin-bottom: 0.8rem;
    color: var(--gold-primary);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    letter-spacing: 0.02em;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-quote {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--text-muted);
    font-size: 0.95rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .footer-links {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .footer-links a {
    color: var(--gold-primary);
  }

  @media (max-width: 960px) {
    .wiki-content-area {
      padding: 1.2rem 1rem 3rem 1rem;
    }
    .wiki-article {
      padding: 1.5rem 1.25rem;
    }
    .article-title {
      font-size: 1.85rem;
    }
  }
</style>

<script>
  function setupScrollProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    window.addEventListener('scroll', () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const progress = total > 0 ? (window.scrollY / total) * 100 : 0;
      bar.style.width = `${progress}%`;
    });
  }

  setupScrollProgress();
  document.addEventListener('astro:after-swap', setupScrollProgress);

  // Resilient Mermaid Diagram Renderer
  async function renderMermaidDiagrams() {
    // Find all potential Mermaid code blocks across different highlighting outputs
    const rawNodes = Array.from(document.querySelectorAll(
      'pre[data-language="mermaid"], pre.astro-code[data-language="mermaid"], pre > code.language-mermaid, pre.astro-code'
    ));

    const mermaidNodes = rawNodes.filter(node => {
      const pre = (node.tagName === 'PRE' ? node : node.closest('pre')) as HTMLElement | null;
      if (!pre) return false;
      if (pre.getAttribute('data-language') === 'mermaid') return true;
      const text = pre.textContent?.trim() || '';
      return /^(graph|flowchart|sequenceDiagram|stateDiagram|classDiagram|erDiagram|gantt|pie|gitGraph)\b/.test(text);
    });

    if (!mermaidNodes.length) return;

    try {
      // Multi-CDN fallback loader with @vite-ignore to prevent Vite preload wrapping
      let mermaidMod: any = null;
      const cdnUrls = [
        'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs',
        'https://cdnjs.cloudflare.com/ajax/libs/mermaid/11.4.1/mermaid.esm.min.mjs',
        'https://unpkg.com/mermaid@11/dist/mermaid.esm.min.mjs',
        'https://esm.sh/mermaid@11'
      ];

      for (const url of cdnUrls) {
        try {
          const mod = await import(/* @vite-ignore */ url);
          if (mod && (mod.default || mod.render)) {
            mermaidMod = mod.default || mod;
            break;
          }
        } catch {
          // Try next CDN fallback
        }
      }

      if (!mermaidMod) {
        console.warn('Failed to load Mermaid module from all CDN sources.');
        return;
      }

      const mermaid = mermaidMod;
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'loose',
        theme: 'base',
        fontFamily: "'Alegreya', Georgia, serif",
        themeVariables: {
          darkMode: isDark,
          fontFamily: "'Alegreya', Georgia, serif",
          fontSize: '15px',
          primaryColor: isDark ? '#1f1726' : '#fdfaf3',
          primaryTextColor: isDark ? '#fdfaf2' : '#1c1712',
          primaryBorderColor: isDark ? '#e5b85a' : '#8c6b23',
          lineColor: isDark ? '#e5b85a' : '#8c6b23',
          secondaryColor: isDark ? '#261b30' : '#f5efe4',
          tertiaryColor: isDark ? '#16101c' : '#eae1d3',
          mainBkg: isDark ? '#1f1726' : '#fdfaf3',
          nodeBorder: isDark ? '#e5b85a' : '#8c6b23',
          nodeTextColor: isDark ? '#fdfaf2' : '#1c1712',
          clusterBkg: isDark ? 'rgba(31, 23, 38, 0.7)' : 'rgba(245, 239, 228, 0.7)',
          clusterBorder: isDark ? '#e5b85a' : '#8c6b23',
          titleColor: isDark ? '#e5b85a' : '#8c6b23',
          edgeLabelBackground: isDark ? '#16101c' : '#fdfaf3',
        }
      });

      let idx = 0;
      for (const node of mermaidNodes) {
        const pre = (node.tagName === 'PRE' ? node : node.closest('pre')) as HTMLElement | null;
        if (!pre) continue;

        let rawCode = pre.dataset.rawMermaid;
        if (!rawCode) {
          rawCode = pre.textContent?.trim() || '';
          pre.dataset.rawMermaid = rawCode;
        }

        const id = `mermaid-svg-${Date.now()}-${idx++}`;
        try {
          const { svg } = await mermaid.render(id, rawCode);

          let container = pre.previousElementSibling as HTMLElement | null;
          if (!container || !container.classList.contains('wiki-mermaid-container')) {
            container = document.createElement('div');
            container.className = 'wiki-mermaid-container';
            pre.parentNode?.insertBefore(container, pre);
          }

          container.innerHTML = svg;
          pre.style.display = 'none';

          // Prevent narrow diagrams from squishing
          const svgEl = container.querySelector('svg');
          if (svgEl) {
            const vb = svgEl.getAttribute('viewBox');
            if (vb) {
              const parts = vb.split(' ').map(Number);
              const w = parts[2];
              if (w && w < 480) {
                svgEl.style.maxWidth = `${Math.max(w * 1.45, 400)}px`;
                svgEl.style.width = '100%';
              } else {
                svgEl.style.maxWidth = '100%';
              }
            }
          }
        } catch (err) {
          console.warn('Mermaid rendering error for node:', err);
          pre.style.display = 'block';
        }
      }
    } catch (err) {
      console.warn('Failed to load Mermaid module:', err);
    }
  }

  renderMermaidDiagrams();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
  }
  document.addEventListener('astro:after-swap', renderMermaidDiagrams);
  window.addEventListener('load', renderMermaidDiagrams);

  // Re-render with matching palette whenever user toggles light/dark theme
  const themeObserver = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.attributeName === 'data-theme') {
        renderMermaidDiagrams();
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
