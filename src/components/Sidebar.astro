---

<aside id="wiki-sidebar" class="wiki-sidebar">
  <div class="sidebar-filter-wrapper">
    <input
      type="text"
      id="sidebar-filter-input"
      placeholder="Filter topics..."
      aria-label="Filter sidebar navigation"
    />
  </div>

  <nav class="sidebar-nav">
    <a href={`${baseUrl}/`} class={`sidebar-home-link ${!currentSlug ? 'active' : ''}`}>
      <span class="home-icon">🏠</span>
      <span>Wiki Portal Home</span>
    </a>

    {navSections.map((sec, secIdx) => (
      <div class="nav-group" data-section-idx={secIdx}>
        <button class="nav-group-header" aria-expanded="true">
          <span class="group-title">{sec.title}</span>
          <span class="group-chevron">▾</span>
        </button>
        <ul class="nav-group-items">
          {sec.items.map((item) => {
            const isActive = currentSlug === item.slug || currentSlug.endsWith(item.slug);
            return (
              <li class="nav-item">
                <a
                  href={`${baseUrl}/wiki/${item.slug}`}
                  class={`nav-item-link ${isActive ? 'active' : ''}`}
                  title={item.title}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  .wiki-sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    height: calc(100vh - var(--header-height));
    position: sticky;
    top: var(--header-height);
    overflow-y: auto;
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    padding: 1.2rem 1rem 3rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    z-index: 50;
  }

  .sidebar-filter-wrapper {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg-surface);
    padding-bottom: 0.5rem;
  }

  #sidebar-filter-input {
    width: 100%;
    padding: 0.45rem 0.8rem;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.25);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #sidebar-filter-input:focus {
    border-color: var(--gold-primary);
    box-shadow: 0 0 8px rgba(229, 184, 90, 0.2);
  }

  .sidebar-home-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--gold-primary);
    text-decoration: none;
    margin-bottom: 0.8rem;
    border: 1px solid var(--border-subtle);
    background: rgba(229, 184, 90, 0.06);
    transition: all 0.2s ease;
  }

  .sidebar-home-link:hover, .sidebar-home-link.active {
    background: rgba(229, 184, 90, 0.15);
    border-color: var(--gold-primary);
    box-shadow: var(--gold-glow);
  }

  .nav-group {
    margin-bottom: 0.8rem;
  }

  .nav-group-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.5rem;
    background: transparent;
    border: none;
    color: var(--gold-primary);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.4rem;
  }

  .group-chevron {
    transition: transform 0.2s ease;
    font-size: 0.85rem;
  }

  .nav-group.collapsed .group-chevron {
    transform: rotate(-90deg);
  }

  .nav-group.collapsed .nav-group-items {
    display: none;
  }

  .nav-group-items {
    list-style: none;
    padding-left: 0.5rem;
    margin: 0;
  }

  .nav-item {
    margin: 0.15rem 0;
  }

  .nav-item-link {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 5px;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: all 0.15s ease;
    border-left: 2px solid transparent;
  }

  .nav-item-link:hover {
    color: var(--gold-light);
    background: rgba(229, 184, 90, 0.08);
    border-left-color: var(--gold-primary);
    transform: translateX(2px);
  }

  .nav-item-link.active {
    color: #fff;
    background: rgba(229, 184, 90, 0.18);
    border-left-color: var(--gold-primary);
    font-weight: 600;
    box-shadow: 0 0 10px rgba(229, 184, 90, 0.15);
  }

  @media (max-width: 960px) {
    .wiki-sidebar {
      position: fixed;
      left: -100%;
      top: var(--header-height);
      height: calc(100vh - var(--header-height));
      width: 290px;
      transition: left 0.3s ease;
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.7);
    }
    :global(body.sidebar-mobile-open) .wiki-sidebar {
      left: 0;
    }
  }
</style>

<script>
  function setupSidebar() {
    // Collapsible sections
    document.querySelectorAll('.nav-group-header').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.nav-group');
        if (!group) return;
        const isCollapsed = group.classList.toggle('collapsed');
        btn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      });
    });

    // Real-time topic filter
    const filterInput = document.getElementById('sidebar-filter-input');
    if (!filterInput) return;

    filterInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const items = document.querySelectorAll('.nav-item');

      items.forEach((item) => {
        const text = item.textContent?.toLowerCase() || '';
        const match = !q || text.includes(q);
        item.style.display = match ? 'block' : 'none';
      });

      // Show/hide section header based on whether any children are visible
      document.querySelectorAll('.nav-group').forEach((group) => {
        const visibleItems = group.querySelectorAll('.nav-item[style*="display: block"], .nav-item:not([style*="display: none"])');
        group.style.display = (visibleItems.length > 0 || !q) ? 'block' : 'none';
      });
    });
  }

  setupSidebar();
  document.addEventListener('astro:after-swap', setupSidebar);
</script>
