---
// SearchModal.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="search-modal" class="search-modal-backdrop" aria-hidden="true">
  <div class="search-modal-container glass-panel">
    <div class="search-input-wrapper">
      <span class="search-icon">🔍</span>
      <input
        type="search"
        id="wiki-search-input"
        placeholder="Search the Loom... (e.g., Telara, City of Brass, Strahd, Pale Lodge)"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="esc-kbd">ESC</kbd>
    </div>

    <div id="search-results-container" class="search-results-list">
      <div class="search-placeholder">
        <p>Type to search 190+ documents across the fractured multiverse...</p>
        <div class="search-quick-tags">
          <span class="quick-filter" data-query="Gods">⚡ Gods</span>
          <span class="quick-filter" data-query="Elemental">🔥 Elemental Planes</span>
          <span class="quick-filter" data-query="Factions">🏛️ Factions</span>
          <span class="quick-filter" data-query="NPCs">👥 Dramatis Personae</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(4, 3, 5, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .search-modal-backdrop.is-open {
    display: flex;
    opacity: 1;
  }

  .search-modal-container {
    width: 90%;
    max-width: 650px;
    background: var(--bg-surface-solid);
    border: 1px solid var(--border-strong);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), var(--gold-glow);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
    animation: searchScale 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes searchScale {
    from { transform: scale(0.96) translateY(-10px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
  }

  .search-icon {
    font-size: 1.2rem;
    opacity: 0.7;
  }

  #wiki-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-main);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    outline: none;
  }

  #wiki-search-input::placeholder {
    color: var(--text-faint);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .esc-kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: var(--text-faint);
  }

  .search-results-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
  }

  .search-placeholder {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--text-muted);
  }

  .search-quick-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .quick-filter {
    background: rgba(229, 184, 90, 0.1);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--gold-primary);
  }

  .quick-filter:hover {
    background: var(--gold-primary);
    color: #000;
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    padding: 0.8rem 1rem;
    border-radius: 8px;
    margin-bottom: 0.4rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background: rgba(229, 184, 90, 0.12);
    border-color: var(--border-strong);
    transform: translateX(3px);
  }

  :global(.search-result-title) {
    font-family: var(--font-heading);
    color: var(--gold-primary);
    font-size: 1.05rem;
    font-weight: 600;
  }

  :global(.search-result-cat) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }
</style>

<script define:vars={{ baseUrl }}>
  let searchData = null;
  let selectedIndex = -1;

  async function loadSearchData() {
    if (searchData) return searchData;
    try {
      const res = await fetch(`${baseUrl}/api/search.json`);
      searchData = await res.json();
      return searchData;
    } catch (e) {
      console.error('Failed to load search index:', e);
      return [];
    }
  }

  function setupSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('wiki-search-input');
    const resultsContainer = document.getElementById('search-results-container');
    const triggers = document.querySelectorAll('[data-open-search]');

    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      loadSearchData();
      setTimeout(() => input.focus(), 50);
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      input.value = '';
      selectedIndex = -1;
    }

    triggers.forEach(t => t.addEventListener('click', openModal));

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.classList.contains('is-open')) closeModal();
        else openModal();
      } else if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Quick tags
    document.querySelectorAll('.quick-filter').forEach(tag => {
      tag.addEventListener('click', () => {
        const query = tag.getAttribute('data-query');
        input.value = query;
        performSearch(query);
      });
    });

    input.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });

    async function performSearch(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        resultsContainer.innerHTML = `
          <div class="search-placeholder">
            <p>Type to search 190+ documents across the fractured multiverse...</p>
          </div>
        `;
        return;
      }

      const data = await loadSearchData();
      const matches = data.filter(item => {
        return item.title.toLowerCase().includes(q) ||
               item.category.toLowerCase().includes(q) ||
               (item.excerpt && item.excerpt.toLowerCase().includes(q));
      }).slice(0, 15);

      if (matches.length === 0) {
        resultsContainer.innerHTML = `
          <div class="search-placeholder">
            <p>No weaver records found matching "<strong>${escapeHtml(query)}</strong>"</p>
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = matches.map((item, idx) => `
        <a href="${baseUrl}/wiki/${item.slug}" class="search-result-item ${idx === 0 ? 'selected' : ''}">
          <span class="search-result-title">${escapeHtml(item.title)}</span>
          <span class="search-result-cat">${escapeHtml(item.category)}</span>
        </a>
      `).join('');

      selectedIndex = 0;
    }

    input.addEventListener('keydown', (e) => {
      const items = resultsContainer.querySelectorAll('.search-result-item');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
        e.preventDefault();
        items[selectedIndex].click();
      }
    });

    function updateSelection(items) {
      items.forEach((item, idx) => {
        item.classList.toggle('selected', idx === selectedIndex);
        if (idx === selectedIndex) {
          item.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    function escapeHtml(str) {
      return str.replace(/[&<>'"]/g, tag => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[tag] || tag));
    }
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
